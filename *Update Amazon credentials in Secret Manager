3. **Update Amazon credentials in Secret Manager**
   ```bash
   # Create a JSON file with your Amazon Ads API credentials
   cat > amazon_ads_creds.json << EOF
   {
     "client_id": "YOUR_AMAZON_ADS_CLIENT_ID",
     "client_secret": "YOUR_AMAZON_ADS_CLIENT_SECRET",
     "refresh_token": "YOUR_AMAZON_ADS_REFRESH_TOKEN",
     "profile_id": "YOUR_PROFILE_ID",
     "region": "NA"
   }
   EOF
   
   # Update the secrets
   gcloud secrets versions add NEW_AMAZON_CLIENT_ID \
     --data-file=amazon_ads_creds.json \
     --project=YOUR_PROJECT_ID
   
   # Create Amazon SP-API credentials
   cat > amazon_sp_creds.json << EOF
   {
     "refresh_token": "YOUR_SP_API_REFRESH_TOKEN",
     "lwa_app_id": "YOUR_LWA_APP_ID",
     "lwa_client_secret": "YOUR_LWA_CLIENT_SECRET",
     "aws_access_key": "YOUR_AWS_ACCESS_KEY",
     "aws_secret_key": "YOUR_AWS_SECRET_KEY",
     "role_arn": "YOUR_ROLE_ARN"
   }
   EOF
   
   gcloud secrets versions add amazon-sp-default \
     --data-file=amazon_sp_creds.json \
     --project=YOUR_PROJECT_ID
   
   # Clean up sensitive files
   rm amazon_ads_creds.json amazon_sp_creds.json
