# .env.example
# Google Cloud
PROJECT_ID=your-project-id
GOOGLE_CLOUD_PROJECT=your-project-id
BIGQUERY_DATASET=amazon_ppc
REGION=us-central1

# Timezone
TIMEZONE=America/New_York

# Bid Configuration
MIN_BID=0.35
MAX_BID=7.00
SUGGEST_BLEND=0.70
MAX_UP_PCT_PER_RUN=0.20
MAX_DOWN_PCT_PER_RUN=0.25

# Safety Gates
PAUSE_CLICKS_MIN=15
PAUSE_SPEND_MIN=18.0
LOSE_CLICKS_MIN=10
LOSE_SPEND_MIN=10.0

# Secret Manager Secret Names
AMAZON_CLIENT_ID_SECRET=amazon_client_id
AMAZON_CLIENT_SECRET_SECRET=amazon_client_secret
AMAZON_REFRESH_TOKEN_SECRET=amazon_refresh_token
AMAZON_PROFILE_ID_SECRET=amazon_profile_id
